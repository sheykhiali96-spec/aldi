{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aldi",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "615e2dab-7381-44fd-aab1-d269536efad5","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "802bb3074b1d4044bc1f5582639c8e50" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
